# LINE Developers 後台 › Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 機器人自己的 userId（U 開頭），用來判斷有沒有被 @
BOT_USER_ID=
# 你自己的 userId：私訊只回你、花費警報也傳給你
OWNER_USER_ID=
# 選填：逗號分隔，只讓這些人在群組裡使用；留空＝群組裡所有人都能用
ALLOWED_USERS=

# Claude Console 建立的 API 金鑰（用量計費，不是 Claude 訂閱方案）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

BOT_NAME=小欣
PORT=8001
# 對外網址（Cloudflare Tunnel 的網址），目前只用在說明，選填
PUBLIC_BASE=
# 1＝不呼叫 LINE，把要回的話印在終端機；沒有 LINE 帳號也能先測
DRY_RUN=0
